# Copy this file to .env and adjust values as needed.

# Absolute or relative path to the hospital dataset (CSV).
# Defaults to data/rumahsakit_medicalclinicid_cleaned.csv when unset.
DATA_FILE=data/rumahsakit_medicalclinicid_cleaned.csv

# Number of records rendered on the initial page load.
INITIAL_RESULTS=50

# Maximum number of matches returned per search request.
MAX_SEARCH_RESULTS=100

# Port for the local development server.
PORT=5000

# Flask secret key. Override with a strong random value in production.
SECRET_KEY=dev-secret-key
